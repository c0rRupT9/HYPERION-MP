CXX = g++
CXXFLAGS = -O2 -std=c++17 -MMD -MP
BIN_NAME = main
BUILD_DIR = build
SRCS = main.cpp
OBJS = $(addprefix $(BUILD_DIR)/,$(SRCS:.cpp=.o))
DEPS = $(OBJS:.o=.d)
PROG ?= stressTest
CYC ?= 100
TRACE ?= 0000
PROG_PATH = ../programs/

# Detect OS & Set Extensions
ifeq ($(OS),Windows_NT)
    EXE = .exe
    EXEC = $(TARGET)
    PYTHON = python
    MKDIR_CMD = powershell -Command "New-Item -ItemType Directory -Force -Path $(BUILD_DIR) | Out-Null"
    RM_CMD = powershell -Command "Remove-Item -Recurse -Force -Path $(BUILD_DIR), ../hexTraces/*.txt, ../programs/*.hex -ErrorAction SilentlyContinue"
    RM_CMD_HEX = powershell -Command "Remove-Item -Path ../hexTraces/*.txt -ErrorAction SilentlyContinue"
else
    EXE =
    EXEC = ./$(TARGET)
    PYTHON = python3
    MKDIR_CMD = mkdir -p $(BUILD_DIR)
    RM_CMD = rm -rf $(BUILD_DIR) ../hexTraces/*.txt ../programs/*.hex
    RM_CMD_HEX = rm -f ../hexTraces/*.txt
endif

# Target files
TARGET = $(BUILD_DIR)/$(BIN_NAME)$(EXE)
ASM_SRC = $(PROG_PATH)$(PROG).asm
TARGETPROG = $(PROG_PATH)$(PROG).hex

.PHONY: all asm run debug debugInline clean cleanHex


all: $(TARGET)

# Link step - only relinks if object files changed
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(TARGET)

# Compile step - recompiles if .cpp OR any included header changed,
# tracked via the auto-generated .d files below. Ensures build/ exists first.
$(BUILD_DIR)/%.o: %.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR):
	$(MKDIR_CMD)

# Pull in header dependency info generated by -MMD, if present
-include $(DEPS)

asm: $(TARGETPROG)

# Re-assemble only if .asm source is newer than .hex file
$(TARGETPROG): $(ASM_SRC)
	$(PYTHON) ../tools/assembler.py $(ASM_SRC)

run: $(TARGET) $(TARGETPROG)
	$(EXEC) $(TARGETPROG) -c $(CYC)

debug: $(TARGET) $(TARGETPROG)
	$(EXEC) $(TARGETPROG) -d -c $(CYC)
	$(PYTHON) ../tools/trace_reconstruct.py ../hexTraces/$(TRACE).txt

debugInline: $(TARGET) $(TARGETPROG)
	$(EXEC) $(TARGETPROG) -t -c $(CYC)

clean:
	$(RM_CMD)

cleanHex:
	$(RM_CMD_HEX)